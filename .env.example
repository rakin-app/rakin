# Every variable the stack reads, with a working local default.
# Copy to `.env` and adjust; `.env` is never committed.

# --- api ---
# local | test | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# The API's login user, a member of the `rakin_app` role. This user and the owner
# below are created by `python -m app.db_bootstrap` (see backend/README.md).
DATABASE_URL=postgresql+asyncpg://rakin_api:rakin_api@localhost:5432/rakin
# The table owner; used by Alembic only. Not a superuser.
MIGRATION_DATABASE_URL=postgresql+asyncpg://rakin_owner:rakin_owner@localhost:5432/rakin
DB_POOL_SIZE=5
HEALTHZ_DB_TIMEOUT_SECONDS=2.0

# --- docker compose ---
# Port Caddy serves the app on: http://localhost:8080
HTTP_PORT=8080
# The Postgres container's superuser. Only `migrate` sees it, to create the
# two users below.
POSTGRES_USER=rakin
POSTGRES_PASSWORD=rakin
POSTGRES_DB=rakin
POSTGRES_PORT=5432
# The users in DATABASE_URL and MIGRATION_DATABASE_URL above, which those URLs
# use for an api run on the host. Inside Compose the URLs are built from these
# (with host `postgres`), so change a password here and in its URL together;
# the next `docker compose up` resets it in Postgres. URL-safe characters only.
POSTGRES_API_USER=rakin_api
POSTGRES_API_PASSWORD=rakin_api
POSTGRES_OWNER_USER=rakin_owner
POSTGRES_OWNER_PASSWORD=rakin_owner

# --- object storage (BlobStore) ---
# Hosted deployments point these at a real S3-compatible provider.
# Server-side calls from api and jobs: `garage` inside Compose
# (http://localhost:3900 for an api run on the host).
S3_ENDPOINT_URL=http://garage:3900
# Presigned URLs, which the browser uploads to directly, so it must be able to
# reach this one: the `selfhost` Garage is published on localhost:3900.
S3_PUBLIC_ENDPOINT_URL=http://localhost:3900
S3_REGION=garage
S3_BUCKET=rakin
# Garage key ids are `GK` + 24 hex chars, secrets 64 hex chars.
# These are local-only defaults: replace them on any reachable host.
S3_ACCESS_KEY_ID=GKd06e218c3fa3bb3f69e9d09e
S3_SECRET_ACCESS_KEY=af635cf10ca8d78993f886624767e63600cb52fa8e7730c15d026ace93a3f341

# --- garage (only with `--profile selfhost`) ---
# 64 hex chars; `openssl rand -hex 32` for a real one.
GARAGE_RPC_SECRET=57d9a189650872044edafa9a57fe77e8180e79f7979e4ea6a6d3e86d67297576
GARAGE_S3_PORT=3900
