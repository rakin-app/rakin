# Every variable the stack reads, with a working local default.
# Copy to `.env` and adjust; `.env` is never committed.

# --- api ---
# local | test | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# The API's login user, a member of the `rakin_app` role. This user and the owner
# below are created by `python -m app.db_bootstrap` (see backend/README.md).
DATABASE_URL=postgresql+asyncpg://rakin_api:rakin_api@localhost:5432/rakin
# The table owner; used by Alembic only. Not a superuser.
MIGRATION_DATABASE_URL=postgresql+asyncpg://rakin_owner:rakin_owner@localhost:5432/rakin
DB_POOL_SIZE=5
HEALTHZ_DB_TIMEOUT_SECONDS=2.0
# Signs upload URLs and links. The API refuses to start in production with this
# default: `openssl rand -hex 32`.
SECRET_KEY=local-only-secret-change-me
# Encrypts sensitive custom-field values at rest. Refused in production with this
# default: `openssl rand -hex 32`. Changing it makes the stored values unreadable.
FIELD_ENCRYPTION_KEY=local-only-field-key-change-me
# Where the browser reaches the app; absolute links the API hands out start here.
PUBLIC_BASE_URL=http://localhost:8080
# Each gym is served at <slug>.BASE_DOMAIN, on PUBLIC_BASE_URL's scheme and port:
# `localhost` serves the demo gym at http://academia-sur.localhost:8080. Empty
# serves every gym on PUBLIC_BASE_URL alone.
BASE_DOMAIN=

# --- jobs (backend/app/jobs) ---
# The nightly jobs' calendar: a day's jobs run once that day has begun here.
JOBS_TIMEZONE=America/Santiago
# A Sentry project DSN: failed jobs are reported there. Empty sends nothing.
SENTRY_DSN=

# --- integrations (backend/app/integrations) ---
# Every one has a default that needs no network and no account.
# console (log every message, send nothing) | smtp (any server; hosted Rakin
# uses smtp.resend.com, user `resend`, an API key as the password)
MAILER=console
MAIL_FROM=Rakin <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=587
# starttls (587) | tls (465) | none (a local relay only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10.0
# wame: build wa.me links the admin sends from their own phone
MESSENGER=wame
# none: students pay by transfer and upload a proof
PAYMENT_RAIL=none
# none: payments are validated by hand
BANK_FEED=none

# --- join link form (HumanCheck) ---
# none: no check beyond the honeypot and rate limits.
# turnstile: Cloudflare Turnstile, with the site's two keys.
HUMAN_CHECK=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- docker compose ---
# Port Caddy serves the app on: http://localhost:8080
HTTP_PORT=8080
# The Postgres container's superuser. Only `migrate` sees it, to create the
# two users below.
POSTGRES_USER=rakin
POSTGRES_PASSWORD=rakin
POSTGRES_DB=rakin
POSTGRES_PORT=5432
# The users in DATABASE_URL and MIGRATION_DATABASE_URL above, which those URLs
# use for an api run on the host. Inside Compose the URLs are built from these
# (with host `postgres`), so change a password here and in its URL together;
# the next `docker compose up` resets it in Postgres. URL-safe characters only.
POSTGRES_API_USER=rakin_api
POSTGRES_API_PASSWORD=rakin_api
POSTGRES_OWNER_USER=rakin_owner
POSTGRES_OWNER_PASSWORD=rakin_owner

# --- object storage (BlobStore) ---
# local: files on disk under BLOB_LOCAL_DIR, served by the api itself on the page's
# own host, so it works on gym subdomains with no CORS rule.
# s3: any S3-compatible store, configured below; use it with `--profile selfhost`
# (Garage) or point the S3_* values at a real provider.
BLOB_STORE=local
BLOB_LOCAL_DIR=var/blobs
# How long a presigned upload or download URL stays valid.
BLOB_URL_TTL_SECONDS=900
# Server-side calls from api and jobs: `garage` inside Compose
# (http://localhost:3900 for an api run on the host).
S3_ENDPOINT_URL=http://garage:3900
# Presigned URLs, which the browser uploads to directly, so it must be able to
# reach this one: the `selfhost` Garage is published on localhost:3900.
S3_PUBLIC_ENDPOINT_URL=http://localhost:3900
S3_REGION=garage
S3_BUCKET=rakin
# Garage key ids are `GK` + 24 hex chars, secrets 64 hex chars.
# These are local-only defaults: replace them on any reachable host.
S3_ACCESS_KEY_ID=GKd06e218c3fa3bb3f69e9d09e
S3_SECRET_ACCESS_KEY=af635cf10ca8d78993f886624767e63600cb52fa8e7730c15d026ace93a3f341

# --- garage (only with `--profile selfhost`) ---
# 64 hex chars; `openssl rand -hex 32` for a real one.
GARAGE_RPC_SECRET=57d9a189650872044edafa9a57fe77e8180e79f7979e4ea6a6d3e86d67297576
GARAGE_S3_PORT=3900
