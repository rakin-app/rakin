# Every variable the stack reads, with a working local default.
# Copy to `.env` and adjust; `.env` is never committed.

# --- api ---
# local | test | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# The API's login user, a member of the `rakin_app` role (see backend/README.md)
DATABASE_URL=postgresql+asyncpg://rakin_api:rakin_api@localhost:5432/rakin
# The table owner; used by Alembic only
MIGRATION_DATABASE_URL=postgresql+asyncpg://rakin:rakin@localhost:5432/rakin
DB_POOL_SIZE=5
HEALTHZ_DB_TIMEOUT_SECONDS=2.0
