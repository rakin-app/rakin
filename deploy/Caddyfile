# The hosted Caddy, baked into the `rakin-web` image with the built SPA under
# /srv (deploy/web.Dockerfile). One origin for the SPA and the API, as in dev.
# SITE_ADDRESS is a bare host name, so Caddy gets and renews its certificate
# from Let's Encrypt and redirects HTTP to HTTPS.
#
# Each gym is also served on its own host, <slug>.BASE_DOMAIN (#155). Those
# certificates are on demand: one per gym's host, obtained at its first TLS
# handshake, and only once the api's `ask` endpoint says a gym is there
# (backend/app/api/hosts.py). So there is no wildcard certificate and no DNS
# plugin, and a name no gym has never reaches Let's Encrypt. Caddy 2.8 dropped
# on_demand_tls's own `interval` and `burst`: `ask` is the rate limit, and
# Let's Encrypt's per-domain limits apply beyond it.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/internal/tls-allowed
	}
}

(app) {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Vite fingerprints everything under /assets. The rest (index.html, on
		# every client-side route) is revalidated, so a deploy reaches the
		# browser on its next load. `header` runs before `try_files`, so it
		# matches the path the browser asked for.
		#
		# The service worker (sw.js, registerSW.js, workbox-*.js, #68) is in
		# that rest, at the root: it must never move under /assets, where a
		# year's cache would keep every browser on the old worker for good.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		# Client-side routes (the router owns every other path) get the SPA.
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS} {
	import app
}

*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	import app
}
