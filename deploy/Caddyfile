# The hosted Caddy, baked into the `rakin-web` image with the built SPA under
# /srv (deploy/web.Dockerfile). One origin for the SPA and the API, as in dev.
# SITE_ADDRESS is a bare host name, so Caddy gets and renews its certificate
# from Let's Encrypt and redirects HTTP to HTTPS.
#
# Each gym is also served on its own host, <slug>.BASE_DOMAIN (#155). Those
# certificates are on demand: one per gym's host, obtained at its first TLS
# handshake, and only once the api's `ask` endpoint says a gym is there
# (backend/app/api/hosts.py). So there is no wildcard certificate and no DNS
# plugin, and a name no gym has never reaches Let's Encrypt. Caddy 2.8 dropped
# on_demand_tls's own `interval` and `burst`: `ask` is the rate limit, and
# Let's Encrypt's per-domain limits apply beyond it.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:8000/internal/tls-allowed
	}
}

(app) {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Vite fingerprints everything under /assets. The rest (index.html, on
		# every client-side route) is revalidated, so a deploy reaches the
		# browser on its next load. `header` runs before `try_files`, so it
		# matches the path the browser asked for.
		#
		# The service worker (sw.js, registerSW.js, workbox-*.js, #68) is in
		# that rest, at the root: it must never move under /assets, where a
		# year's cache would keep every browser on the old worker for good.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		# Client-side routes (the router owns every other path) get the SPA.
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS} {
	import app
}

# rakin.app, the landing page (#343): the static site site/build.py writes,
# under /srv/site. www redirects to the apex. A host block beats the gyms'
# wildcard below, so `www` (a reserved slug, app/hosts.py) never reaches the app.
# Caddy writes no access log here: the privacy notice says the site keeps none.
{$LANDING_HOST}, www.{$LANDING_HOST} {
	encode zstd gzip

	@www host www.{$LANDING_HOST}
	redir @www {scheme}://{$LANDING_HOST}{uri} permanent

	root * /srv/site
	# Captures, loops and fonts: a week. site/build.py names each capture and
	# loop for its content, so one taken again has a new name. The pages are
	# revalidated, so a deploy shows on the next load.
	@static path /img/* /video/* /fonts/*
	header @static Cache-Control "public, max-age=604800"
	@pages not path /img/* /video/* /fonts/*
	header @pages Cache-Control "no-cache"
	file_server
}

*.{$BASE_DOMAIN} {
	tls {
		on_demand
	}
	import app
}

# The gyms' old domain (#464): MOVED_FROM_DOMAIN, staging.rakin.app on production.
# <slug>.<it> redirects to <slug>.BASE_DOMAIN and <it> itself to the base host,
# path and query kept: 301 for GET and HEAD, 308 for the rest, which keeps the
# method and body (as the api's alias redirects, app/hosts.py). Both names are on
# demand, so production asks Let's Encrypt only for the names the api's `ask`
# allows (a gym's or an alias's slug, and the old base host), and a host with the
# setting empty (Compose passes moved.invalid) asks for nothing. It only
# redirects: no encode, no file_server, and no access log.
{$MOVED_FROM_DOMAIN:moved.invalid}, *.{$MOVED_FROM_DOMAIN:moved.invalid} {
	tls {
		on_demand
	}

	# The site's wildcard is one label, so the slug is the host's first label,
	# however many labels the old domain has. The old base host is matched first,
	# as it would pass for a slug too.
	map {host} {moved_to} {
		{$MOVED_FROM_DOMAIN:moved.invalid} {$PUBLIC_BASE_URL}
		~^([^.]+)\. "https://${1}.{$BASE_DOMAIN}"
	}
	@get method GET HEAD
	@other not method GET HEAD
	redir @get {moved_to}{uri} 301
	redir @other {moved_to}{uri} 308
}
