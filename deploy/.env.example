# The hosted stack's settings (deploy/docker-compose.yml), with production's
# values (app.rakin.app, gyms at <slug>.rakin.app). Copy to the host as
# /srv/rakin/.env, mode 600, and fill in every <...>. It never leaves the host:
# not the repo, not the image, not a CI secret. The repo-root .env.example
# explains each setting; this file holds the hosted values. Generate secrets
# with `openssl rand -hex 32`, afresh on each host: none is ever copied from
# production to staging (docs/deploy.md#3-the-hosts-env).
#
# The staging host (Nuremberg, seed data only) differs in
# (docs/deploy.md#the-staging-host):
#   SITE_ADDRESS=staging.rakin.app
#   PUBLIC_BASE_URL=https://staging.rakin.app
#   BASE_DOMAIN=staging.rakin.app
#   LANDING_HOST=sitio.staging.rakin.app
#   MOVED_FROM_DOMAIN=                    (empty)
#   SEED_ONLY=1
#   STAGING_OPERATORS=<the PM's and the owner's addresses>
#   SENTRY_ENVIRONMENT=staging            (same SENTRY_DSN)
#   MAIL_ALLOW=<the team's own addresses>
#   SMTP_PASSWORD=<a Resend key of its own, named for staging>
#   RESEND_WEBHOOK_SECRET=                (empty)
#   S3_BUCKET=rakin-staging-seed, with a token scoped to it alone
#   COMPOSE_PROFILES and BACKUP_*         unset: no backups
#   and its own SECRET_KEY, FIELD_ENCRYPTION_KEY and POSTGRES_*_PASSWORD.

# --- release ---
# The image tag running now. deploy.sh rewrites this line on every deploy and
# rollback, so plain `docker compose ...` on the host targets the live release.
RAKIN_TAG=<v0.1.0>

# --- caddy ---
# The base host: sign-in, /plataforma, the Resend webhook.
SITE_ADDRESS=app.rakin.app
ACME_EMAIL=<ops@rakin.app>
# The landing page (#343), served by this Caddy; www.<it> redirects to it.
LANDING_HOST=rakin.app

# --- api and jobs ---
ENVIRONMENT=production
LOG_LEVEL=INFO
DB_POOL_SIZE=5
HEALTHZ_DB_TIMEOUT_SECONDS=2.0
SECRET_KEY=<openssl rand -hex 32>
# Never change once set: it decrypts the sensitive custom fields.
FIELD_ENCRYPTION_KEY=<openssl rand -hex 32>
PUBLIC_BASE_URL=https://app.rakin.app
# Each gym at <slug>.BASE_DOMAIN (meta.rakin.app); caddy reads it too.
BASE_DOMAIN=rakin.app
# The gyms' previous domain, whose names redirect to BASE_DOMAIN's (#464,
# docs/deploy.md#old-addresses). Empty redirects nothing, as on staging.
MOVED_FROM_DOMAIN=staging.rakin.app
# 1 only on a host that holds seed data alone (staging): `app.seed` refuses on
# production without it.
SEED_ONLY=false
# Staging only, and read by reset-staging.sh, not Compose: comma-separated
# addresses it makes platform operators again after each nightly reset
# (docs/deploy.md#the-staging-host). Uncomment it there.
# STAGING_OPERATORS=
JOBS_TIMEZONE=America/Santiago
# The Sentry project's DSN; the api and the jobs report errors there.
SENTRY_DSN=<https://...@....ingest.us.sentry.io/...>
# `staging` on the staging host; empty reports ENVIRONMENT (production).
SENTRY_ENVIRONMENT=

# --- mail: Resend over SMTP ---
MAILER=smtp
# An address on a domain verified in Resend (DKIM, SPF and the return path in
# Cloudflare DNS).
MAIL_FROM=Rakin <no-reply@rakin.app>
SMTP_HOST=smtp.resend.com
# STARTTLS on 587; 465 with SMTP_SECURITY=tls works too.
SMTP_PORT=587
SMTP_SECURITY=starttls
# Staging: comma-separated addresses or @domains that get mail; every other
# message is logged, not sent. Empty (production) sends to everyone.
MAIL_ALLOW=
# Resend's SMTP user is always `resend`; the password is an API key with
# "Sending access", ideally scoped to rakin.app.
SMTP_USERNAME=resend
SMTP_PASSWORD=<re_...>
SMTP_TIMEOUT_SECONDS=10.0
# The signing secret of the Resend webhook to https://<PUBLIC_BASE_URL host>/api/webhooks/resend,
# with the email.bounced and email.complained events (docs/deploy.md): its whsec_...
# Empty turns the webhook off, and bounced addresses go on being mailed.
RESEND_WEBHOOK_SECRET=

MESSENGER=wame
PAYMENT_RAIL=none
BANK_FEED=none

# --- join link form (HumanCheck) ---
# none: no check beyond the honeypot and rate limits.
# turnstile: Cloudflare Turnstile, with the site's two keys.
HUMAN_CHECK=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- object storage: Cloudflare R2 (or S3) ---
BLOB_STORE=s3
# Unused with BLOB_STORE=s3; listed so every setting is.
BLOB_LOCAL_DIR=var/blobs
BLOB_URL_TTL_SECONDS=900
# R2: https://<account-id>.r2.cloudflarestorage.com, region `auto`.
# S3: https://s3.<region>.amazonaws.com and that region.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# The browser PUTs here, so it is public; with R2 or S3 it is the same URL.
S3_PUBLIC_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
# Production's bucket keeps the name it had when its host was called staging.
S3_BUCKET=rakin-staging
# An "Object Read & Write" token scoped to this bucket.
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# --- postgres ---
# The superuser; only `postgres` and `migrate` see it.
POSTGRES_USER=rakin
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=rakin
POSTGRES_API_USER=rakin_api
POSTGRES_API_PASSWORD=<openssl rand -hex 32>
POSTGRES_OWNER_USER=rakin_owner
POSTGRES_OWNER_PASSWORD=<openssl rand -hex 32>

# --- backups (app/backup.py, deploy/restore.sh) ---
# Opt-in: set the BACKUP_* lines below, then uncomment this to run the `backup`
# service (docs/deploy.md#setting-them-up). Without it, they are not needed.
# COMPOSE_PROFILES=backup
# The folder in the bucket: rakin/<BACKUP_ENV>/<UTC timestamp>.dump.age.
# Production's stays `staging`, the folder its backups have always gone to.
BACKUP_ENV=staging
# The public half of an age key made on a laptop (`age-keygen`); the private
# half lives in the password manager, never on this host.
BACKUP_AGE_RECIPIENT=<age1...>
# A bucket of its own, not S3_BUCKET, and an "Object Read & Write" token scoped
# to it alone.
BACKUP_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=rakin-backups
BACKUP_S3_ACCESS_KEY_ID=<access-key-id>
BACKUP_S3_SECRET_ACCESS_KEY=<secret-access-key>
