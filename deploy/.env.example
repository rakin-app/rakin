# The hosted stack's settings (deploy/docker-compose.yml), for staging.rakin.app.
# Copy to the host as /srv/rakin/.env, mode 600, and fill in every <...>. It
# never leaves the host: not the repo, not the image, not a CI secret.
# The repo-root .env.example explains each setting; this file holds the
# hosted values. Generate secrets with `openssl rand -hex 32`.

# --- release ---
# The image tag running now. deploy.sh rewrites this line on every deploy and
# rollback, so plain `docker compose ...` on the host targets the live release.
RAKIN_TAG=<v0.1.0>

# --- caddy ---
SITE_ADDRESS=staging.rakin.app
ACME_EMAIL=<ops@rakin.app>

# --- api and jobs ---
ENVIRONMENT=production
LOG_LEVEL=INFO
DB_POOL_SIZE=5
HEALTHZ_DB_TIMEOUT_SECONDS=2.0
SECRET_KEY=<openssl rand -hex 32>
# Never change once set: it decrypts the sensitive custom fields.
FIELD_ENCRYPTION_KEY=<openssl rand -hex 32>
PUBLIC_BASE_URL=https://staging.rakin.app
# Each gym at <slug>.BASE_DOMAIN (meta.staging.rakin.app); caddy reads it too.
# Production's will be rakin.app.
BASE_DOMAIN=staging.rakin.app
JOBS_TIMEZONE=America/Santiago
# The Sentry project's DSN; the api and the jobs report errors there.
SENTRY_DSN=<https://...@....ingest.sentry.io/...>

# --- mail: Resend over SMTP ---
MAILER=smtp
# An address on a domain verified in Resend (DKIM, SPF and the return path in
# Cloudflare DNS).
MAIL_FROM=Rakin <no-reply@rakin.app>
SMTP_HOST=smtp.resend.com
# STARTTLS on 587; 465 with SMTP_SECURITY=tls works too.
SMTP_PORT=587
SMTP_SECURITY=starttls
# Resend's SMTP user is always `resend`; the password is an API key with
# "Sending access", ideally scoped to rakin.app.
SMTP_USERNAME=resend
SMTP_PASSWORD=<re_...>
SMTP_TIMEOUT_SECONDS=10.0

MESSENGER=wame
PAYMENT_RAIL=none
BANK_FEED=none

# --- join link form (HumanCheck) ---
# none: no check beyond the honeypot and rate limits.
# turnstile: Cloudflare Turnstile, with the site's two keys.
HUMAN_CHECK=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- object storage: Cloudflare R2 (or S3) ---
BLOB_STORE=s3
# Unused with BLOB_STORE=s3; listed so every setting is.
BLOB_LOCAL_DIR=var/blobs
BLOB_URL_TTL_SECONDS=900
# R2: https://<account-id>.r2.cloudflarestorage.com, region `auto`.
# S3: https://s3.<region>.amazonaws.com and that region.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# The browser PUTs here, so it is public; with R2 or S3 it is the same URL.
S3_PUBLIC_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=rakin-staging
# An "Object Read & Write" token scoped to this bucket.
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# --- postgres ---
# The superuser; only `postgres` and `migrate` see it.
POSTGRES_USER=rakin
POSTGRES_PASSWORD=<openssl rand -hex 32>
POSTGRES_DB=rakin
POSTGRES_API_USER=rakin_api
POSTGRES_API_PASSWORD=<openssl rand -hex 32>
POSTGRES_OWNER_USER=rakin_owner
POSTGRES_OWNER_PASSWORD=<openssl rand -hex 32>
